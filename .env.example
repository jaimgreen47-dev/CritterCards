# Server
NODE_ENV=development
PORT=3000

# Commission Rate (as decimal: 0.15 = 15%)
COMMISSION_RATE=0.15

# Stripe Webhook
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret
